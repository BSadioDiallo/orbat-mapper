{
  "name": "@orbat-mapper/web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "e2e": "node e2e/critical-paths.e2e.cjs",
    "parity:reference": "cd ../.. && vitest run --config apps/web/parity/vitest.parity.config.mts"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@lucide/angular": "^1.67.0",
    "@turf/turf": "^7.4.0",
    "@vue/reactivity": "3.5.44",
    "@vvo/tzdb": "^6.202.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compare-versions": "^6.1.1",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.53.1",
    "fflate": "^0.8.3",
    "filenamify": "^7.0.3",
    "idb": "^8.0.4",
    "immer": "^11.2.9",
    "klona": "^2.0.6",
    "maplibre-gl": "^6.16.0",
    "markdown-it": "^14.3.3",
    "milsymbol": "^3.0.5",
    "nanoid": "^5.1.16",
    "rfc6902": "^5.4.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
